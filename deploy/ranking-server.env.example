# /etc/ranking-server.env 의 템플릿. 실서버에 적용 시 다음을 따른다:
#   1) sudo cp deploy/ranking-server.env.example /etc/ranking-server.env
#   2) 아래 __REPLACE_ME__ 값을 실제 운영 비밀로 교체
#   3) sudo chown root:root /etc/ranking-server.env
#   4) sudo chmod 600 /etc/ranking-server.env
#
# systemd EnvironmentFile 규칙:
#   - KEY=VALUE 형식만 허용 (export 키워드 X, 양쪽 공백 X)
#   - 값을 따옴표로 감싸지 말 것 (따옴표가 값에 그대로 포함된다)
#   - 한 줄에 한 변수, # 는 주석

DB_URL=jdbc:mysql://localhost:3306/ranking_game?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=ranking_app
DB_PASSWORD=__REPLACE_ME__
RANKING_SECRET=__REPLACE_ME__
